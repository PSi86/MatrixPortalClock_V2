{
  "build": {
    "arduino": {
      "partitions": "partitions_wallclock.csv",
      "memory_type": "opi_opi"
    },
    "core": "esp32",
    "extra_flags": [
      "-DARDUINO_WAVESHARE_ESP32S3_RGB_MATRIX",
      "-DARDUINO_USB_CDC_ON_BOOT=1",
      "-DARDUINO_USB_MODE=1",
      "-DARDUINO_RUNNING_CORE=1",
      "-DARDUINO_EVENT_RUNNING_CORE=1",
      "-DBOARD_HAS_PSRAM"
    ],
    "f_cpu": "240000000L",
    "f_flash": "80000000L",
    "flash_mode": "opi",
    "psram_type": "opi",
    "hwids": [
      [
        "0x303A",
        "0x1001"
      ]
    ],
    "mcu": "esp32s3",
    "variant": "waveshare_esp32s3_rgb_matrix"
  },
  "connectivity": [
    "bluetooth",
    "wifi"
  ],
  "debug": {
    "openocd_target": "esp32s3.cfg"
  },
  "frameworks": [
    "arduino",
    "espidf"
  ],
  "name": "Waveshare ESP32-S3-RGB-Matrix (N32R16V) as the wall clock, the clock's flash layout",
  "upload": {
    "flash_size": "32MB",
    "maximum_ram_size": 327680,
    "maximum_size": 33554432,
    "require_upload_port": true,
    "before_reset": "default-reset",
    "after_reset": "watchdog-reset",
    "speed": 921600
  },
  "url": "https://docs.waveshare.com/ESP32-S3-RGB-Matrix",
  "vendor": "Waveshare"
}
