// Optional template: copy to src/arduino_secrets.h and fill in your own
// WiFi credentials. The real file is excluded from the repository via
// .gitignore. A clock that has no WiFi stored copies these into flash on its
// first start, once; after that the WiFi is changed on the config page, and
// editing this file no longer changes it. Without the file the build still
// compiles, and the WiFi is set on the config page.
#define SECRET_SSID "YOUR_WIFI_NAME"
#define SECRET_PASS "YOUR_WIFI_PASSWORD"
