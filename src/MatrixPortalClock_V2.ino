// While the hotspot has the panel: the band dark, once; it starts again after.
void bandHide() {
  if (bandHidden) { return; }
  bandHidden = true;
  bandRestart();
  bandPicture.fillScreen(0);
  matrix.showBand(bandPicture.getBuffer());
}
