#if WEBUI_APP
/* ----------------------------------------------------------------------
   The web app (S3): one page, webui/index.html, which the build gzips into
   webui_page.h (scripts/embed_webui.py), and the JSON interface it works on.
   It reads with GET /api/state (everything once), /api/status (what moves)
   and /api/panel (the canvas as it is drawn), and writes with the same
   parameters the old page sent, through the same handlers: applyLiveParams(),
   applyParams(), applyKeysForm(), applyGifParams(), applyFeedParams(),
   applyWifiForm().
   ---------------------------------------------------------------------- */

// Collects what a Print-based helper writes, for a JSON string.
class StringPrint : public Print {
 public:
  String text;
  size_t write(uint8_t b) override { text += (char)b; return 1; }
};

void sendWebApp(Print &c) {
  c.println("HTTP/1.1 200 OK");
  c.println("Content-Type: text/html; charset=utf-8");
  c.println("Content-Encoding: gzip");
  c.print("Content-Length: "); c.println(WEBUI_GZ_LEN);
  c.println("Cache-Control: no-cache");
  c.println("Connection: close");
  c.println();
  c.write(WEBUI_GZ, WEBUI_GZ_LEN);
}

void sendJson(Print &c, JsonDocument &doc, int code = 200) {
  c.print("HTTP/1.1 "); c.print(code);
  c.println(code == 200 ? " OK" : code == 400 ? " Bad Request" : code == 404 ? " Not Found" : " Error");
  c.println("Content-Type: application/json");
  c.println("Cache-Control: no-store");
  c.println("Connection: close");
  c.println();
  serializeJson(doc, c);
}

void sendJsonError(Print &c, int code, const char *text) {
  JsonDocument d;
  d["error"] = text;
  sendJson(c, d, code);
}

// The home WiFi as the clock last found it, as plain text (printHomeWifiStatus()
// writes the same for the old page, with its markup).
String homeWifiStatusText() {
  if (!wifiStored()) { return "No home WiFi stored: the clock gets no time from the internet."; }
  StringPrint t;
  t.print(wifiCreds.ssid);
  switch (joinOutcome) {
    case JOIN_SUCCEEDED:
      t.print(": last joined "); printAgo(t, joinOutcomeAt);
      t.print(", signal "); t.print(joinRssi); t.print(" dBm");
      break;
    case JOIN_FAILED:
      t.print(": could not join "); printAgo(t, joinOutcomeAt);
      t.print(" ("); t.print(joinFailText(joinFailStatus)); t.print(")");
      break;
    default:
      t.print(": not joined since the clock started");
      break;
  }
  t.print(wifiCreds.verified ? ". A known-good config." : ". A new config: no sync has worked over it yet.");
  return t.text;
}

const char *resetReasonText() {
  switch (esp_reset_reason()) {
    case ESP_RST_POWERON:   return "power-on";
    case ESP_RST_SW:        return "restart by the firmware";
    case ESP_RST_PANIC:     return "a crash";
    case ESP_RST_INT_WDT:
    case ESP_RST_TASK_WDT:
    case ESP_RST_WDT:       return "a watchdog";
    case ESP_RST_BROWNOUT:  return "a brownout (supply too weak)";
    case ESP_RST_DEEPSLEEP: return "deep sleep";
    case ESP_RST_EXT:       return "the reset button";
    case ESP_RST_USB:       return "USB";
    default:                return "unknown";
  }
}

const char *timeSourceText() {
  switch (timeSource) {
    case TIME_NTP:    return "NTP";
    case TIME_PHONE:  return "phone";
    case TIME_MANUAL: return "by hand";
    case TIME_RTC:    return "RTC";
    default:          return "none";
  }
}

// What moves: the panel's brightness and light, the time, the screen, and the
// info band's sources and items. Polled by the page.
void apiStatusInto(JsonDocument &d) {
  d["bright"] = effectiveBrightness;
  if (lastLux >= 0) { d["lux"] = serialized(String(lastLux, 1)); } else { d["lux"] = nullptr; }
  d["clockSet"] = clockIsSet();
  if (clockIsSet()) {
    time_t local = clockNow() + tzTotalOffset();
    char hm[8];
    snprintf(hm, sizeof(hm), "%02d:%02d", clockHour(local), clockMinute(local));
    d["clock"] = hm;
  }
  d["src"] = timeSourceText();
  d["timeLine"] = timeStatusText();
  d["rot"] = matrix.getRotation();
  d["screen"] = (uint8_t)screen;
  d["gif"] = (screen == SCREEN_GIF);
#if BAND_DATA
  JsonArray feeds = d["feeds"].to<JsonArray>();
  for (uint8_t f = 0; f < FEED_COUNT; f++) {
    const FeedRun &r = feedRuns[f];
    JsonObject o = feeds.add<JsonObject>();
    o["on"] = feedOn(f);
    o["always"] = FEEDS[f].needsAlways;   // needs continuous network access
    // Why it does not fetch, if it does not: the page says so.
    if (!feedSettings.located)                       { o["blocked"] = "place"; }
    else if (!wifiStored())                          { o["blocked"] = "wifi"; }
    else if (FEEDS[f].needsAlways && !lanSettings.on) { o["blocked"] = "always"; }
    else if (!clockIsSet())                          { o["blocked"] = "time"; }
    o["failures"] = r.failures;
    if (r.error[0]) { o["error"] = r.error; }
    if (r.okAt) {
      char when[16];
      bandWhen(when, sizeof(when), r.okAt);
      o["okAt"] = when;
      o["ms"] = r.ms;
      if (r.bytes >= 0) { o["bytes"] = r.bytes; }
    }
  }
  d["place"] = feedPlace;
  JsonArray items = d["items"].to<JsonArray>();
  for (uint8_t i = 0; i < bandItemCount; i++) {
    JsonObject o = items.add<JsonObject>();
    char until[16];
    bandWhen(until, sizeof(until), bandItems[i].until);
    o["key"] = bandItems[i].key;
    o["text"] = bandItems[i].text;
    o["icon"] = bandItems[i].icon;
    o["alert"] = bandItems[i].level == LEVEL_ALERT;
    o["until"] = until;
#if HA_LINK
    o["ha"] = bandItems[i].feed == SOURCE_HA;
#endif
  }
#endif
#if HA_LINK
  haStatusInto(d["haStatus"].to<JsonObject>());
#endif
}

