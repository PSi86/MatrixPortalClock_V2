// The clock's time from a phone (utc=) or typed in (date= and time=, the
// clock's local time). Answers with the new status line.
void apiSetTime(Print &c, const String &q) {
  String utc = getParam(q, "utc");
  if (utc.length()) {
    int64_t t = strtoll(utc.c_str(), nullptr, 10);
    if (t < UTC_PLAUSIBLE_FROM || t > UTC_PLAUSIBLE_TO) { sendJsonError(c, 400, "Not set: the phone's time looks wrong."); return; }
    setClockTo((time_t)t, TIME_PHONE);
    Serial.print("Time set from a phone: "); Serial.println((unsigned long)t);
  } else {
    String date = getParam(q, "date"), hm = getParam(q, "time");
    int y = date.substring(0, 4).toInt(), mo = date.substring(5, 7).toInt(), dd = date.substring(8, 10).toInt();
    int h = hm.substring(0, 2).toInt(), mi = hm.substring(3, 5).toInt();
    if (date.length() != 10 || hm.length() < 5 || y < 2024 || y > 2099 || mo < 1 || mo > 12 ||
        dd < 1 || dd > 31 || h < 0 || h > 23 || mi < 0 || mi > 59) {
      sendJsonError(c, 400, "Not set: enter both a date and a time.");
      return;
    }
    time_t local = (time_t)daysFromCivil(y, mo, dd) * 86400 + h * 3600 + mi * 60;
    setClockTo(localToUtc(local), TIME_MANUAL);
    Serial.println("Time set by hand");
  }
  JsonDocument d;
  d["timeLine"] = timeStatusText();
  sendJson(c, d);
}

// Save: every setting the page sends, checked first where a check can refuse
// (the face shortcuts must leave a way into the menu), so a refused save
// changes nothing.
void apiSave(Print &c, const String &body, bool &closeHotspot) {
  String error = applyKeysForm(body);
  if (error.length()) { sendJsonError(c, 400, error.c_str()); return; }
  applyParams(body);
  applySettings();            // the runtime copies: animation speed, sync time
  setDstMode(settings.dst);   // a new zone's daylight-saving rule counts at once
  saveSettings();
#if WATCHFACE_TETRIS
  saveTetrisSettings();
#endif
  saveUiSettings();
  saveFaceKeys();
#if BAND_DATA
  applyNoticeKeysForm(body);
  saveNoticeKeys();
#endif
  if (!ntpSyncOn() && syncState != SYNC_IDLE) { setSyncState(SYNC_IDLE); }
#if GIF_PLAYBACK
  applyGifParams(body);
  saveGifSettings();
  gifScheduleNext();          // the new times count from now
#endif
#if BAND_DATA
  applyFeedParams(body);
  saveFeedSettings();
#endif
  Serial.println("Settings saved from the web app");
  JsonDocument d;
  d["ok"] = true;
  d["closing"] = apActive;    // in the hotspot, saving closes it, as it always has
  sendJson(c, d);
  closeHotspot = apActive;
}

void webApi(Print &c, const String &path, bool isPost, const String &body,
            bool &closeHotspot, bool &syncNow, bool &restart) {
  if (path == "/api/state") { apiState(c); return; }
  if (path == "/api/status") {
    JsonDocument d;
    apiStatusInto(d);
    sendJson(c, d);
    return;
  }
  if (path == "/api/panel") { apiPanel(c); return; }
  if (path == "/api/gestures") { apiGestures(c); return; }
  if (!isPost) { sendJsonError(c, 404, "Unknown request."); return; }
  if (path == "/api/gesturetest") {
    // on=1 starts the gesture test over the face, on=0 ends it; tune=1 or 0
    // alone switches the sensor's wave settings.
    String tune = getParam(body, "tune");
    if (tune.length() && gestureOK) { gestureTune(tune == "1"); }
    String on = getParam(body, "on");
    if (on == "1") { gestureTestStart(); } else if (on == "0") { gestureTestStop(); }
    apiGestures(c);
    return;
  }
  if (path == "/api/live") {
    applyLiveParams(body);    // RAM only; Save keeps it, Discard reads the stored settings back
    sendNoContent(c);
  } else if (path == "/api/save") {
    apiSave(c, body, closeHotspot);
  } else if (path == "/api/discard") {
    loadSettings();           // the stored settings, with the Tetris ones, applied at once
#if WATCHFACE_TETRIS
    shakePreviewReq = true;   // show what was restored
#endif
    sendNoContent(c);
  } else if (path == "/api/time") {
    apiSetTime(c, body);
  } else if (path == "/api/wifi") {
    String error = applyWifiForm(body);
    if (error.length()) { sendJsonError(c, 400, error.c_str()); return; }
    saveWifiCreds();
    JsonDocument d;
    d["ok"] = true;
    d["closing"] = apActive;
    sendJson(c, d);
    if (apActive) { closeHotspot = true; syncNow = true; }   // join it and fetch the time at once
  } else if (path == "/api/forget") {
    forgetWifi();
    JsonDocument d;
    d["line"] = homeWifiStatusText();
    sendJson(c, d);
#if GIF_PLAYBACK
  } else if (path == "/api/gif") {
    bool onFace = (screen == SCREEN_FACE);
    if (onFace) { gifPlayNow(); }
    JsonDocument d;
    d["playing"] = onFace && screen == SCREEN_GIF;
    sendJson(c, d);
#endif
#if BAND_DATA
  } else if (path == "/api/messages") {
    // The notices once more, as FN_SHOW_MESSAGES shows them; a GIF on show
    // ends for them.
#if GIF_PLAYBACK
    if (screen == SCREEN_GIF) { closeScreen(); }
#endif
    JsonDocument d;
    d["onFace"] = screen == SCREEN_FACE;
    d["shown"] = noticesShowAgain();
    sendJson(c, d);
#endif
  } else if (path == "/api/lan") {
    apiLan(c, body);
#if HA_LINK
  } else if (path == "/api/ha") {
    apiHa(c, body);
#endif
  } else if (path == "/api/restart") {
    sendNoContent(c);
    restart = true;
  } else {
    sendJsonError(c, 404, "Unknown request.");
  }
}
// ---- The web app on the home network -------------------------------------------

void loadLanSettings() {
  lanStore.begin("lan");
  lanStore.read(lanSettings);
  if (lanSettings.magic != LAN_SETTINGS_MAGIC) {
    memset(&lanSettings, 0, sizeof(lanSettings));
    lanSettings.magic = LAN_SETTINGS_MAGIC;
    lanSettings.rev = LAN_SETTINGS_REV;
  }
  // Like the hotspot, the access comes with a password set: the hotspot's
  // (decided by Peter, 2026-10-08). The page says while it is still that one.
  if (!lanSettings.hasPassword) {
    lanSetPassword(AP_PASS);
    lanSettings.on = 0;
    saveLanSettings();
  }
  lanWantRadio();
  if (lanSettings.on) { Serial.printf("Web app on the home network: on, as %s.local\n", netHostname()); }
}

void saveLanSettings() {
  lanSettings.magic = LAN_SETTINGS_MAGIC;
  lanSettings.rev = LAN_SETTINGS_REV;
  lanStore.write(lanSettings);
}

// While it is on, the station stays joined.
void lanWantRadio() {
  if (lanSettings.on) { radioUsers |= RADIO_LAN; } else { radioUsers &= (uint8_t)~RADIO_LAN; }
}

void lanHash(const char *pw, uint8_t out[32]) {
  uint8_t buf[16 + 64];
  size_t n = strnlen(pw, 63);
  memcpy(buf, lanSettings.salt, 16);
  memcpy(buf + 16, pw, n);
  mbedtls_sha256(buf, 16 + n, out, 0);
}

// A new password, with a new salt.
void lanSetPassword(const char *pw) {
  for (uint8_t i = 0; i < 16; i += 4) {
    uint32_t r = esp_random();
    memcpy(lanSettings.salt + i, &r, 4);
  }
  lanHash(pw, lanSettings.hash);
  lanSettings.hasPassword = 1;
}

// Whether the password is pw (used to say that the hotspot's still is).
bool lanPasswordIs(const char *pw) {
  uint8_t h[32];
  lanHash(pw, h);
  return lanSettings.hasPassword && memcmp(h, lanSettings.hash, 32) == 0;
}

// Whether a request from the home network carries the password ("Basic" and
// base64 of "user:password", any user name). Answers it with 401 or 429 if not.
bool lanAuthorized(Print &c, const String &auth) {
  if (lanLocked && millisNow - lanLockedAt < LAN_LOCK_MS) {
    sendJsonError(c, 429, "Too many wrong passwords. Wait half a minute.");
    return false;
  }
  lanLocked = false;
  bool ok = false;
  if (lanSettings.hasPassword && auth.startsWith("Basic ")) {
    String b64 = auth.substring(6);
    b64.trim();
    unsigned char dec[200];
    size_t n = 0;
    if (mbedtls_base64_decode(dec, sizeof(dec) - 1, &n, (const unsigned char *)b64.c_str(), b64.length()) == 0) {
      dec[n] = '\0';
      const char *colon = strchr((const char *)dec, ':');
      uint8_t h[32];
      lanHash(colon ? colon + 1 : (const char *)dec, h);
      uint8_t diff = 0;
      for (uint8_t i = 0; i < 32; i++) { diff |= h[i] ^ lanSettings.hash[i]; }   // the same time for every wrong byte
      ok = (diff == 0);
    }
  }
  if (ok) { lanFails = 0; return true; }
  if (auth.length() && ++lanFails >= 5) {
    lanFails = 0;
    lanLocked = true;
    lanLockedAt = millisNow;
    Serial.println("Web app: five wrong passwords - no more tries for 30 s");
  }
  sendJsonError(c, 401, "The clock's password is needed.");
  return false;
}

// /api/lan: on (on or off) and a new password (pw, 8 to 63 characters,
// optional once one is set). Switching on needs a password.
void apiLan(Print &c, const String &body) {
  bool on = getParam(body, "on") == "on";
  String pw = getParam(body, "pw");
  if (pw.length() && (pw.length() < 8 || pw.length() > 63)) {
    sendJsonError(c, 400, "The password must be 8 to 63 characters long.");
    return;
  }
  if (on && !pw.length() && !lanSettings.hasPassword) {
    sendJsonError(c, 400, "Set a password to switch the home network access on.");
    return;
  }
  if (pw.length()) { lanSetPassword(pw.c_str()); }
  lanSettings.on = on ? 1 : 0;
  saveLanSettings();
  lanWantRadio();
  Serial.printf("Web app on the home network: %s%s\n", on ? "on" : "off", pw.length() ? ", new password" : "");
  JsonDocument d;
  d["ok"] = true;
  d["on"] = on;
  d["host"] = netHostname();
  sendJson(c, d);
}

void lanStop() {
  if (!lanServing) { return; }
  apServer.end();
  MDNS.end();
  WiFi.setSleep(true);
  lanServing = false;
  Serial.println("Web app on the home network: stopped");
}

// On every pass outside the hotspot: the server on the home network while the
// access is on and the station is up, and one request of it.
void lanUpdate() {
  bool want = lanSettings.on && stationUp();
  if (want && !lanServing) {
    // No modem sleep while the page may be open: with it, every answer waited
    // for the next beacon, and the page took 1.2 s to load (2026-10-08).
    WiFi.setSleep(false);
    apServer.begin();
    bool named = MDNS.begin(netHostname());
    if (named) { MDNS.addService("http", "tcp", 80); }
    lanServing = true;
    Serial.printf("Web app on the home network: http://%s.local, http://%s\n", netHostname(),
                  WiFi.localIP().toString().c_str());
    if (!named) { Serial.println("Web app: mDNS did not start; the address works"); }
  } else if (!want && lanServing) {
    lanStop();
  }
  if (!lanServing) { return; }
  WiFiClient client = netServerAccept(apServer);
  if (!client) { return; }
  netClientTimeoutMs(client, 100);
  serveClient(client, true);
}
